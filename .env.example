# ==================== 应用配置 ====================
APP_NAME=QLib因子分析平台
APP_VERSION=1.0.0
LOG_LEVEL=INFO
THEME=Light

# ==================== QLib 配置 ====================
QLIB_PROVIDER_URI=~/.qlib/qlib_data/cn_data
QLIB_REGION=cn

# ==================== 数据配置 ====================
CACHE_DIR=./cache
DATA_EXPIRE_DAYS=7
MAX_MEMORY_USAGE=2GB

# ==================== 性能配置 ====================
N_JOBS=4
CHUNK_SIZE=1000

# ==================== Redis 配置 ====================
# 阿里云 Redis（云数据库 Redis 版）
REDIS_HOST=r-bp1xxxxx.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password
REDIS_MAX_MEMORY_MB=10.0
REDIS_POOL_SIZE=5

# 或本地 Redis（开发环境）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ==================== OSS 配置 ====================
# 阿里云 OSS
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET_NAME=quant-data

# ==================== 通联配置 ====================
# 通联认证 Token（32字符）
TONGLIANG_TOKEN=your_32_char_token_here

# 通联上海 L1
TONGLIANG_SH_L1_HOST=mdl-cloud-sh.datayes.com
TONGLIANG_SH_L1_PORT=19011

# 通联深圳 L1
TONGLIANG_SZ_L1_HOST=mdl-cloud-sz.datayes.com
TONGLIANG_SZ_L1_PORT=19011

# TTL 配置
TONGLIANG_QUOTE_TTL=1
TONGLIANG_KLINE_TTL=60
TONGLIANG_TICK_FLUSH_INTERVAL=10

# ==================== 回测配置 ====================
DEFAULT_BENCHMARK=000300.SH
DEFAULT_ACCOUNT=100000000.0
OPEN_COST=0.0005
CLOSE_COST=0.0015
MIN_COST=5.0

# ==================== 分析配置 ====================
IC_ROLLING_WINDOW=20
LAYER_QUANTILES=5

# ==================== Web 配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
UI_HOST=0.0.0.0
UI_PORT=8501

# ==================== Docker 镜像配置 ====================
# 阿里云容器镜像服务（用于存储策略镜像）
DOCKER_REGISTRY=registry.cn-shanghai.aliyuncs.com/quant-platform
BASE_IMAGE=quant-platform-base:latest

# ==================== 分布式回测 OSS 配置 ====================
# 历史数据存储
OSS_DATA_BUCKET=quant-historical-data
# 回测结果存储
OSS_RESULT_BUCKET=quant-backtest-results

# ==================== 阿里云 ECS 配置 ====================
# 用于创建抢占式实例
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_IMAGE_ID=m-xxx
ALIYUN_SECURITY_GROUP_ID=sg-xxx
ALIYUN_VSWITCH_ID=vsw-xxx

# ==================== 回调配置 ====================
# Worker 回调地址（内网穿透或公网地址）
CALLBACK_BASE_URL=http://your-ip:8000
