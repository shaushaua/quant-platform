# OSS 环境配置文件
# 根据你的网络环境选择配置

# ============================================
# 本地开发环境（公网）
# ============================================
# 使用公网 endpoint，会产生流量费用

export OSS_ACCESS_KEY_ID='your_access_key_id'
export OSS_ACCESS_KEY_SECRET='your_access_key_secret'
export OSS_ENDPOINT='https://oss-cn-hangzhou.aliyuncs.com'  # 公网
export OSS_DATA_BUCKET='quant-mdl-data'

# ============================================
# 集群/VPN 环境（内网）- 注释掉，仅供参考
# ============================================
# export OSS_ENDPOINT='https://oss-cn-hangzhou-internal.aliyuncs.com'  # 内网

# ============================================
# 使用方法
# ============================================
# source .env.local  # 加载配置
# python local_test.py strategy.py --date 20250106 --codes "000001.SZ"
